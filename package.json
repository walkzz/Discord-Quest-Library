{
  "name": "quest-launcher",
  "productName": "Quest-Launcher",
  "version": "1.3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --watch main.js --watch index.html --watch renderer.js --exec electron .",
    "package": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.questautomator.app",
    "icon": "assets/icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "walkzz",
        "repo": "Discord-Quest-Library"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "covers/",
      "legacy/",
      "discord-executables.txt",
      "assets/"
    ],
    "asarUnpack": [
      "legacy/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  }
}
